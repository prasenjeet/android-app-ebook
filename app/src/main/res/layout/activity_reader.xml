<?xml version="1.0" encoding="utf-8"?>
<!--
  ReaderActivity layout.

  ┌──────────────────────────────────────────────────┐
  │               mainWebView (full-screen)           │
  │                                                   │
  │  On Z Fold 5 wide open (vertical fold):           │
  │  ┌──────────────┬───┬──────────────┐             │
  │  │  mainWebView │ | │secondary     │             │
  │  │  (left page) │   │WebView       │             │
  │  └──────────────┴───┴──────────────┘             │
  │                                                   │
  │ pageCurlView sits on top (transparent bg)         │
  │                                                   │
  │         [< Prev]  1 / 10  [Next >]               │
  └──────────────────────────────────────────────────┘
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background">

    <!-- Left / single-panel WebView -->
    <com.example.ebook.reader.EbookWebView
        android:id="@+id/mainWebView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/divider" />

    <!-- Fold divider (hidden by default, visible when Z Fold 5 is fully open) -->
    <View
        android:id="@+id/divider"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/fold_divider"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintStart_toEndOf="@id/mainWebView"
        app:layout_constraintEnd_toStartOf="@id/secondaryWebView" />

    <!-- Right-panel WebView (only shown on fully open Z Fold 5) -->
    <com.example.ebook.reader.EbookWebView
        android:id="@+id/secondaryWebView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PageCurlView overlaid on top of the WebViews, intercepts swipe gestures -->
    <com.example.ebook.reader.PageCurlView
        android:id="@+id/pageCurlView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom navigation bar -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/nav_bar_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrev"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt;"
            android:contentDescription="Previous page" />

        <TextView
            android:id="@+id/pageIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&gt;"
            android:contentDescription="Next page" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
